# Dependencies and local caches
/node_modules/
/.vite/
/.cache/
**/__pycache__/
*.py[cod]

# Production builds and compiler caches
/dist/
*.tsbuildinfo

# Generated verification output (keep test sources)
/output/
/coverage/
/test-results/
/playwright-report/
/blob-report/
/playwright-*/
/temp-playwright-*/

# Runtime and package-manager logs
/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local environment files; templates may be committed
.env
.env.*
!.env.example
!.env.*.example
!.env.sample

# Local editor/tool state and operating-system files
/.cla*/
/.idea/
/.vscode/*
!/.vscode/settings.json
!/.vscode/tasks.json
!/.vscode/launch.json
!/.vscode/extensions.json
/.history/
.DS_Store
Thumbs.db
Desktop.ini
